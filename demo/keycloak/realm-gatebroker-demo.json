{
  "realm": "gatebroker-demo",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "broker-automation",
        "description": "Lets a non-interactive client reach the broker"
      }
    ]
  },
  "groups": [
    {
      "name": "engineering"
    },
    {
      "name": "research"
    },
    {
      "name": "contractors"
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@gatebroker.invalid",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Engineer",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "groups": [
        "/engineering"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@gatebroker.invalid",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Contractor",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "groups": [
        "/contractors"
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@gatebroker.invalid",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Unentitled",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "groups": []
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "The subject claim. Declaring client scopes replaces Keycloak's defaults, and `sub` lives in this one.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "broker",
      "description": "Requests access to the GateBroker API",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "broker-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "gatebroker-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "group-names",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "realm-roles-as-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "gatebroker-api",
      "name": "GateBroker API",
      "description": "The resource the broker validates tokens for. Its client id is the audience.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "gabro-cli",
      "name": "gabro CLI",
      "description": "Public device-code client. Holds no secret, exactly like the real thing.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:*"
      ],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "pkce.code.challenge.method": "S256"
      },
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "broker"
      ],
      "optionalClientScopes": []
    }
  ]
}
